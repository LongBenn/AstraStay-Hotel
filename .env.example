# ==============================================================================
# DATASTAX ASTRA DB / APACHE CASSANDRA CONFIGURATION
# ==============================================================================
# Hướng dẫn:
# 1. Để kết nối Astra DB Cloud:
#    - Tải Secure Connect Bundle zip về và đặt vào thư mục gốc hoặc chỉ định đường dẫn ở biến ASTRA_DB_SECURE_BUNDLE_PATH.
#    - Tạo Application Token với quyền Database Administrator, sao chép token (dạng AstraCS:...) vào ASTRA_DB_APPLICATION_TOKEN.
# 2. Để kết nối Cassandra Local:
#    - Đặt CASSANDRA_CONTACT_POINTS=127.0.0.1:9042 và CASSANDRA_LOCAL_DATACENTER=datacenter1.
# 3. Nếu chưa cấu hình hoặc để trống:
#    - Ứng dụng sẽ kích hoạt chế độ "Smart Mock/Demo Mode" với dữ liệu mô phỏng đầy đủ từ Hotel.cql,
#      cho phép chạy thử và thuyết trình 100% chức năng ngay tức thì.
# ==============================================================================

PORT=3000
NODE_ENV=development

# Astra DB Cloud Settings
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your-token-here
ASTRA_DB_SECURE_BUNDLE_PATH=./secure-connect-hotel_management_demo.zip
ASTRA_DB_KEYSPACE=hotel_reservations_vn

# Cassandra Local Settings (nếu chạy local cluster thay vì Astra DB)
# CASSANDRA_CONTACT_POINTS=127.0.0.1
# CASSANDRA_LOCAL_DATACENTER=datacenter1
# CASSANDRA_KEYSPACE=hotel_reservations_vn
